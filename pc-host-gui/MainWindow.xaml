<Window x:Class="PcHostGui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="XrealBridge Monitor Config"
        Height="940" Width="1080" MinHeight="660" MinWidth="820"
        Background="#1e1e1e">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Background" Value="#333"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#555"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#ddd"/>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="#ddd"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="Padding" Value="8"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#2a2a2a"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#555"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="Margin" Value="4"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="4"/>
            <Setter Property="MinWidth" Value="110"/>
        </Style>
        <Style TargetType="Slider">
            <Setter Property="Margin" Value="4"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Padding" Value="10,4"/>
        </Style>
    </Window.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="180"/>
        </Grid.RowDefinitions>

        <!-- Monitor scan -->
        <GroupBox Grid.Row="0" Header="1. Scan monitors (real + virtual)">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="ScanButton" Content="Scan Monitors" Click="ScanButton_Click"/>
                <TextBlock x:Name="ScanStatusText" VerticalAlignment="Center" Margin="10,0,0,0" Text="Not scanned yet."/>
            </StackPanel>
        </GroupBox>

        <!-- Thumbnails -->
        <GroupBox Grid.Row="1" Header="Detected outputs (click Scan above; each thumbnail is a REAL captured frame, not a guess)">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Height="140">
                <StackPanel x:Name="ThumbnailPanel" Orientation="Horizontal"/>
            </ScrollViewer>
        </GroupBox>

        <!-- Grid designer + virtual monitors, side by side -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <TabControl x:Name="LayoutTabControl" Grid.Column="0" Background="#2a2a2a">
                <TabItem Header="2. Grid layout (simple)">
                    <DockPanel Background="#1e1e1e">
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                            <Button Content="+ Row" Click="AddRow_Click"/>
                            <Button Content="- Row" Click="RemoveRow_Click"/>
                            <Button Content="+ Column" Click="AddColumn_Click"/>
                            <Button Content="- Column" Click="RemoveColumn_Click"/>
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,8,0,8">
                            <TextBlock Text="Tile size:" VerticalAlignment="Center"/>
                            <TextBox x:Name="TileWidthBox" Width="60" Text="1920"/>
                            <TextBlock Text="x" VerticalAlignment="Center"/>
                            <TextBox x:Name="TileHeightBox" Width="60" Text="1080"/>
                            <TextBlock Text="  Gap X/Y:" VerticalAlignment="Center" Margin="12,0,0,0"/>
                            <TextBox x:Name="GapXBox" Width="50" Text="0"/>
                            <TextBox x:Name="GapYBox" Width="50" Text="0"/>
                        </StackPanel>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                            <Grid x:Name="MonitorGridPanel" Margin="4"/>
                        </ScrollViewer>
                    </DockPanel>
                </TabItem>

                <TabItem Header="2. 3D Scene (curved, drag-drop)">
                    <!-- Child order matters here: DockPanel force-fills its LAST child with
                         whatever space is left, regardless of that child's own Dock value. The
                         Grid below (canvas + properties) is the one thing that should get that
                         leftover space, so it's placed last, on purpose, same pattern as the Grid
                         layout tab's ScrollViewer. The two fixed-height rows (toolbar, canvas
                         size) come before it so they just take their own natural compact height. -->
                    <DockPanel Background="#1e1e1e">
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                            <Button Content="+ Add Monitor" Click="AddSceneObject_Click"/>
                            <Button Content="- Remove Selected" Click="RemoveSceneObject_Click"/>
                            <TextBlock Text="Drag panels to place them. Orange dashed lines = camera's field of view; orange panel = outside it, won't show up in the stream." VerticalAlignment="Center" Margin="10,0,0,0" Opacity="0.7" FontSize="11" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,4,4,0">
                            <TextBlock Text="Canvas size:" VerticalAlignment="Center"/>
                            <TextBox x:Name="SceneWidthBox" Width="60" Text="1920" LostFocus="SceneNumericField_LostFocus"/>
                            <TextBlock Text="x" VerticalAlignment="Center"/>
                            <TextBox x:Name="SceneHeightBox" Width="60" Text="1080" LostFocus="SceneNumericField_LostFocus"/>
                            <TextBlock Text="(the composited stream's resolution, not any one panel's)" VerticalAlignment="Center" Margin="8,0,0,0" Opacity="0.7" FontSize="11"/>
                        </StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="200"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" BorderBrush="#444" BorderThickness="1" Margin="4" Background="#151515">
                                <Canvas x:Name="SceneCanvas" Width="480" Height="300" ClipToBounds="True"
                                        MouseMove="SceneCanvas_MouseMove" MouseLeftButtonUp="SceneCanvas_MouseLeftButtonUp"/>
                            </Border>

                            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Margin="4" x:Name="ScenePropertiesPanel" IsEnabled="False">
                                    <TextBlock Text="Selected monitor" FontWeight="Bold" Margin="4,0,4,6"/>
                                    <TextBlock Text="Source:" Margin="4,0,4,0"/>
                                    <ComboBox x:Name="SceneOutputCombo" SelectionChanged="SceneOutputCombo_SelectionChanged"/>
                                    <TextBlock Text="Panel size (m):" Margin="4,6,4,0"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBox x:Name="ScenePanelWidthBox" Width="60" LostFocus="SceneNumericField_LostFocus"/>
                                        <TextBlock Text="x" VerticalAlignment="Center"/>
                                        <TextBox x:Name="ScenePanelHeightBox" Width="60" LostFocus="SceneNumericField_LostFocus"/>
                                    </StackPanel>
                                    <TextBlock x:Name="SceneCurvatureLabel" Text="Curvature: 0 deg" Margin="4,6,4,0"/>
                                    <Slider x:Name="SceneCurvatureSlider" Minimum="0" Maximum="170" ValueChanged="SceneCurvatureSlider_ValueChanged"/>
                                    <TextBlock Text="Position (m): X / Y (up) / Z (depth)" Margin="4,6,4,0"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBox x:Name="ScenePosXBox" Width="55" LostFocus="SceneNumericField_LostFocus"/>
                                        <TextBox x:Name="ScenePosYBox" Width="55" LostFocus="SceneNumericField_LostFocus"/>
                                        <TextBox x:Name="ScenePosZBox" Width="55" LostFocus="SceneNumericField_LostFocus"/>
                                    </StackPanel>
                                    <TextBlock x:Name="SceneYawLabel" Text="Yaw: 0 deg" Margin="4,6,4,0"/>
                                    <Slider x:Name="SceneYawSlider" Minimum="-90" Maximum="90" ValueChanged="SceneYawSlider_ValueChanged"/>
                                    <TextBlock Text="Pitch / Roll (deg):" Margin="4,6,4,0"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBox x:Name="ScenePitchBox" Width="55" LostFocus="SceneNumericField_LostFocus"/>
                                        <TextBox x:Name="SceneRollBox" Width="55" LostFocus="SceneNumericField_LostFocus"/>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </DockPanel>
                </TabItem>
            </TabControl>

            <GroupBox Grid.Column="1" Header="3. Virtual monitors (optional)">
                <StackPanel>
                    <TextBlock x:Name="VddStatusText" TextWrapping="Wrap" Margin="4" Text="Checking driver..."/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Count:" VerticalAlignment="Center" Width="55"/>
                        <TextBox x:Name="VirtualCountBox" Width="50" Text="1"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Size:" VerticalAlignment="Center" Width="55"/>
                        <TextBox x:Name="VirtualWidthBox" Width="60" Text="1920"/>
                        <TextBlock Text="x" VerticalAlignment="Center"/>
                        <TextBox x:Name="VirtualHeightBox" Width="60" Text="1080"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Refresh:" VerticalAlignment="Center" Width="55"/>
                        <TextBox x:Name="VirtualRefreshBox" Width="50" Text="60"/>
                    </StackPanel>
                    <Button Content="Apply (needs admin)" Click="ApplyVirtualMonitors_Click" Margin="4,10,4,4"/>
                    <TextBlock Text="Applying triggers one UAC prompt to reload the driver (Device Manager disable/enable). Re-scan afterward to see the new virtual monitor(s)." TextWrapping="Wrap" Opacity="0.7" FontSize="11" Margin="4"/>
                </StackPanel>
            </GroupBox>
        </Grid>

        <!-- Bridge control -->
        <GroupBox Grid.Row="3" Header="4. Bridge">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="PcHost.exe:" VerticalAlignment="Center" Width="80"/>
                    <TextBox x:Name="PcHostPathBox" Width="500"/>
                    <Button Content="Browse..." Click="BrowsePcHost_Click"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="StartButton" Content="Start Bridge" Click="StartBridge_Click"/>
                    <Button x:Name="StopButton" Content="Stop Bridge" Click="StopBridge_Click" IsEnabled="False"/>
                    <TextBlock x:Name="BridgeStatusText" VerticalAlignment="Center" Margin="10,0,0,0" Text="Stopped"/>
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <!-- Log pane -->
        <GroupBox Grid.Row="4" Header="Log">
            <TextBox x:Name="LogBox" IsReadOnly="True" VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11"
                     TextWrapping="NoWrap" Background="Black" Foreground="#0f0"/>
        </GroupBox>
    </Grid>
</Window>
